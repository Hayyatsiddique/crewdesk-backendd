NODE_ENV=development
PORT=5000
PUBLIC_ORIGIN=http://localhost:5000
ALLOWED_ORIGINS=http://localhost:5000
# Vercel automatically adds its current deployment URL to the allowed origins.
MONGODB_URI=mongodb://127.0.0.1:27017/crewdesk?replicaSet=rs0&directConnection=true
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=
SESSION_HOURS=12
# Set only to the exact number of trusted reverse proxies in front of the app.
TRUST_PROXY_HOPS=0
LOG_LEVEL=info
# Development prints codes to the server terminal. Production requires live.
OTP_PROVIDER=development
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
AIRCALL_API_ID=
AIRCALL_API_TOKEN=
AIRCALL_NUMBER_ID=
# Enable English Twilio Voice alerts only after assigning the Voice channel to a recruiter.
TWILIO_VOICE_ENABLED=false
TWILIO_VOICE_NEW_COMPANY=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VOICE_FROM=
# Used ONLY by npm run admin:create; do not keep ADMIN_PASSWORD after creation.
ADMIN_NAME=Dispatch administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional test-only replica-set URI; never point tests at a production environment.
TEST_MONGODB_URI=
